{
  "extends": "default",
  "meta": { "name": "goose", "description": "goose agent: rw workdir, session data/logs; config read-only; git config read-only; go toolchain with module/build caches" },
  "groups": {
    "include": ["git_config", "go_runtime", "go_runtime_linux"]
  },
  "workdir": { "access": "readwrite" },
  "filesystem": {
    "allow": [
      "$HOME/.local/state/goose",
      "$HOME/.local/share/goose",
      "$HOME/.config/goose/githubcopilot",
      "$HOME/go/pkg",
      "$HOME/.cache/gopls",
      "$HOME/.cache/goimports",
      "$HOME/.cache/golangci-lint"
    ],
    "read": ["$HOME/.config/goose"]
  }
}
